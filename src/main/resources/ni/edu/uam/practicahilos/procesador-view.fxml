<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.ProcesadorController"
      alignment="CENTER"
      spacing="18"
      prefWidth="540"
      prefHeight="380">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Procesador de registros"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label fx:id="lblEstado" text="Esperando inicio"/>

    <ProgressBar fx:id="barraProgreso" progress="0" prefWidth="440"/>

    <Label fx:id="lblPorcentaje" text="0%"/>

    <Label fx:id="lblTiempo" text="Tiempo: 0 ms"/>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnIniciar" text="Iniciar"
                onAction="#iniciarProceso"/>
        <Button fx:id="btnDetener" text="Detener"
                onAction="#detenerProceso" disable="true"/>
        <Button fx:id="btnReiniciar" text="Reiniciar"
                onAction="#reiniciarProceso" disable="true"/>
    </HBox>
</VBox>